  "components": {
    "schemas": {
      "Actor": {
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "is_system_admin",
          "csrf_token"
        ],
        "properties": {
          "csrf_token": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_system_admin": {
            "type": "boolean"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {},
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "Content": {
        "type": "object",
        "required": [
          "title",
          "schema_version",
          "body"
        ],
        "properties": {
          "body": {},
          "schema_version": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CreatePage": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Content"
          },
          {
            "type": "object",
            "required": [
              "request_id"
            ],
            "properties": {
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ]
      },
      "Entry": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "group_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "role": {
            "type": "integer",
            "format": "int32"
          },
          "user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
