# Copy to a protected file outside Git; use URL-encoding for DATABASE_URL password.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgres://wiki:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/wiki
APP_BASE_URL=https://wiki.internal:8443
TLS_DIR=/absolute/path/to/tls
WIKI_BIND=127.0.0.1
WIKI_PORT=8443
WIKI_VERSION=0.1.0-rc1
